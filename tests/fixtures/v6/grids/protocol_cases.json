  "cases": [
    {
      "id": "P1",
      "name": "empty_window_x",
      "kind": "error",
      "endpoint": "/map/grid/driveable",
      "request": {
        "window": {
          "min_x_m": 0.0,
          "min_y_m": 0.0,
          "max_x_m": 0.0,
          "max_y_m": 1.0
        },
        "resolution_m": 0.1,
        "request_seq": 1
      },
      "expected": {
        "http": 400,
        "status": "invalid_input",
        "reason": "empty_window"
      }
    },
    {
      "id": "P2",
      "name": "empty_window_y",
      "kind": "error",
      "endpoint": "/map/grid/driveable",
      "request": {
        "window": {
          "min_x_m": 0.0,
          "min_y_m": 0.0,
          "max_x_m": 1.0,
          "max_y_m": 0.0
