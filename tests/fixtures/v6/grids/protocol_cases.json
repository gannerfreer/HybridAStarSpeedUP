    {
      "id": "P11",
      "name": "preview_plan_consistency",
      "kind": "consistency",
      "endpoints": {
        "preview": "/map/scene/preview",
        "plan": "/plan/scene/{scene_id}"
      },
      "request": {
        "map_id": "mapping_example",
        "map_version": "11561c763ed50322185139ec2dd041d6da72e1bd4e5fc3bb66f6b340d92c088f",
        "window": {
          "min_x_m": 0.0,
          "min_y_m": 0.0,
          "max_x_m": 20.0,
          "max_y_m": 20.0
        },
        "resolution_m": 0.1,
        "obstacles": [
          {
            "id": "obs-a",
            "type": "rectangle",
            "x_min_m": 2.0,
            "y_min_m": 2.0,
            "x_max_m": 4.0,
            "y_max_m": 4.0
          },
          {
            "id": "obs-b",
            "type": "convex_polygon",
            "vertices": [
              {
                "x_m": 10.0,
                "y_m": 10.0
              },
              {
                "x_m": 12.0,
                "y_m": 10.0
              },
              {
                "x_m": 11.0,
                "y_m": 13.0
              }
            ]
          }
        ],
        "request_seq": 9
      },
      "expected": {
        "clipped_window": {
          "min_x_m": 0.0,
          "min_y_m": 0.0,
          "max_x_m": 20.0,
          "max_y_m": 20.0
        },
        "source": "planning_scene",
        "scene_version": "scene_v1",
        "scene_id": "044007e558d42fbe4ff7cafc2a239834cf75ceefc6fbc464425233e799ee22d8",
        "width": 200,
        "height": 200,
        "resolution_m": 0.1,
        "origin": {
          "x_m": 0.0,
          "y_m": 0.0,
          "yaw_rad": 0.0
        },
        "degraded": false,
        "cells_equal": true,
        "scene_id_equal": true
      },
      "notes": "地图服务预览与规划服务输入快照必须对同一有效输入逐格一致（协议 §5 跨服务一致）；窗口 (0,0)-(20,20)、障碍 obs-a/obs-b 均在 v3 地图边界内，scene_id 由规范序列化独立复算。"
    },
    {
      "id": "P12",
      "name": "stale_seq_order",
      "kind": "stale",
      "client": {
        "source": "planning_scene",
        "initial_latest_seq": 0
      },
      "events": [
        {
          "step": 1,
          "action": "request",
          "source": "planning_scene",
          "request_seq": 1,
          "window": {
            "min_x_m": 0.0,
            "min_y_m": 0.0,
            "max_x_m": 3.0,
            "max_y_m": 3.0
          }
        },
        {
          "step": 2,
          "action": "request",
          "source": "planning_scene",
          "request_seq": 2,
          "window": {
            "min_x_m": 0.0,
            "min_y_m": 0.0,
            "max_x_m": 6.0,
            "max_y_m": 6.0
          }
        },
        {
          "step": 3,
          "action": "response",
          "source": "planning_scene",
          "request_seq": 2,
          "window": {
            "min_x_m": 0.0,
            "min_y_m": 0.0,
            "max_x_m": 6.0,
            "max_y_m": 6.0
          }
        },
        {
          "step": 4,
          "action": "response",
          "source": "planning_scene",
          "request_seq": 1,
          "window": {
            "min_x_m": 0.0,
            "min_y_m": 0.0,
            "max_x_m": 3.0,
            "max_y_m": 3.0
          }
        }
      ],
      "expected": {
        "latest_seq": 2,
        "applied_request_seq": 2,
        "applied_window": {
          "min_x_m": 0.0,
          "min_y_m": 0.0,
          "max_x_m": 6.0,
          "max_y_m": 6.0
        },
        "stale_ignored": 1,
        "discarded_request_seq": [
          1
        ]
      },
      "notes": "B(seq=2) 先到应用；A(seq=1) 后到视为陈旧丢弃并计数（协议 §6 规则 1–2）。"
    },
