      }
    },
    {
      "id": "P6",
      "name": "non_finite",
      "kind": "error",
      "endpoint": "/map/grid/driveable",
      "request": {
        "raw_body": "{\"window\":{\"min_x_m\":0.0,\"min_y_m\":0.0,\"max_x_m\":1.0,\"max_y_m\":1.0},\"resolution_m\":1e999}"
      },
      "expected": {
        "http": 400,
        "status": "invalid_input",
        "reason": "non_finite_value",
        "subcases": [
          {
            "token": "1e999",
            "expected": {
              "http": 400,
              "status": "invalid_input",
              "reason": "non_finite_value"
            }
          },
          {
            "token": "NaN（裸 NaN，非法 JSON）",
            "expected": {
              "http": 400,
              "status": "invalid_input",
              "reason": "parse_error"
            }
          }
        ]
      }
    },
