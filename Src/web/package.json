{
  "name": "planner-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "W1 地图显示：TypeScript + React + Canvas 2D 加载 M4 公共地图快照（schema_version 1, type=map_snapshot）",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --reporter=default --reporter=junit --outputFile.junit=reports/junit.xml; rc=$?; node scripts/copy-junit.mjs; exit $rc",
    "test:watch": "vitest",
    "evidence": "vitest run tests/render_check.test.ts",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  }
}
