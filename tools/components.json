{
  "schema_version": 1,
  "type": "planner_components",
  "format": "planner.components",
  "format_version": 1,
  "format_description": "组件注册表。cmake/python 组件：cmake.options（传给 cmake -D 的键值）、cmake.target（构建目标名，信息性）、test.runner（ctest|unittest）、test.label（ctest -L）、test.start_dir/test.pattern（unittest）。npm 组件：dir（相对仓库根的包目录）、install、install_ci（可选，存在 package-lock.json 时优先）、build、test、test_junit（可选，相对 dir 的 JUnit XML 路径，运行后收入运行目录）、service.command/workers；npm 的 build 持有全局编译锁并默认占 1 个 worker 名额（可用 build_workers 覆盖）。公共字段：service.command（长驻服务 argv 模板）、benchmark_suites.<suite>.command （基准 argv 模板）与 .description。命令数组占位符：{repo_root}/{build_dir}/{run_dir}/{profile}/{dir}（{dir}=组件目录）。新增组件只需追加条目，不改 task_runner.py；cmake/python/benchmark 模板中的未知占位符会导致报错。",
  "worker_cap": 4,
  "max_parallel": 4,
  "default_profile": "release",
  "default_suite": "v1",
  "fixtures": {
    "root": "tests/fixtures",
    "manifest_name": "fixture_manifest.sha256.json"
  },
  "components": {
    "tools": {
      "kind": "python",
      "description": "E0 Python 工具与自身测试（标准库 unittest，无 pip 依赖）",
      "test": {
        "runner": "unittest",
        "start_dir": "tools/tests",
        "pattern": "test_*.py"
      },
      "benchmark_suites": {}
    },
    "common": {
      "kind": "cmake",
      "description": "公共类型与 JSON 编解码（planner_common，C++17，ROS-free）",
      "cmake": {
        "options": {
          "PLANNER_BUILD_COMMON": "ON"
        },
        "target": "planner_common"
      },
      "test": {
        "runner": "ctest",
        "label": "common"
      },
      "benchmark_suites": {}
    },
    "grid": {
      "kind": "cmake",
      "description": "通用栅格数学与校验（planner_grid；依赖 common，不暴露 Lanelet2，不运行搜索）",
      "cmake": {
        "options": {
          "PLANNER_BUILD_GRID": "ON"
        },
        "target": "planner_grid"
      },
      "test": {
        "runner": "ctest",
        "label": "grid"
      },
      "benchmark_suites": {}
    },
    "scene": {
      "kind": "cmake",
      "description": "地图窗口 + 可行驶域栅格 + 用户障碍的场景组合（planner_scene；依赖 map/grid/collision）",
      "cmake": {
        "options": {
          "PLANNER_BUILD_SCENE": "ON",
          "PLANNER_BUILD_MAP": "ON",
          "PLANNER_BUILD_GRID": "ON",
          "PLANNER_BUILD_COLLISION": "ON"
        },
        "target": "planner_scene"
      },
      "test": {
        "runner": "ctest",
        "label": "scene"
      },
      "benchmark_suites": {}
    },
    "rs": {
      "kind": "cmake",
      "description": "Reeds–Shepp 距离与曲线（OMPL 1.6.0 对照；对照开关默认 ON，OFF 不下载/不链接）",
      "cmake": {
        "options": {
          "PLANNER_BUILD_RS": "ON",
          "PLANNER_RS_WITH_OMPL": "ON"
        },
        "target": "planner_rs"
      },
      "test": {
        "runner": "ctest",
        "label": "rs"
      },
      "benchmark_suites": {
        "v1": {
          "command": [
            "{build_dir}/Src/rs/planner_rs_bench",
            "--suite",
            "v1",
            "--output-dir",
            "{run_dir}/outputs"
          ],
          "description": "正式基准（独占窗口）；指标契约见 tools/README.md“基准输出契约”"
        }
      }
    },
    "collision": {
      "kind": "cmake",
      "description": "碰撞检测（位姿、运动段、路径）",
      "cmake": {
        "options": {
          "PLANNER_BUILD_COLLISION": "ON"
        },
        "target": "planner_collision"
      },
      "test": {
        "runner": "ctest",
        "label": "collision"
      },
      "benchmark_suites": {
        "v1": {
          "command": [
            "{build_dir}/Src/collision/planner_collision_bench",
            "--suite",
            "v1",
            "--output-dir",
            "{run_dir}/outputs"
          ],
          "description": "正式基准（独占窗口）；指标契约见 tools/README.md“基准输出契约”"
        }
      }
    },
    "bspline": {
      "kind": "cmake",
      "description": "B-spline 曲线库（TinySpline 0.6.0 首版封装基线；EGO 对照开关默认 ON，OFF 不编译/不链接 GPL 隔离库）",
      "cmake": {
        "options": {
          "PLANNER_BUILD_BSPLINE": "ON",
          "PLANNER_BSPLINE_WITH_EGO": "ON"
        },
        "target": "planner_bspline"
      },
      "test": {
        "runner": "ctest",
        "label": "bspline"
      },
      "benchmark_suites": {
        "v1": {
          "command": [
            "{build_dir}/Src/bspline/planner_bspline_bench",
            "--suite",
            "v1",
            "--output-dir",
            "{run_dir}/outputs"
          ],
          "description": "正式基准（独占窗口）；指标契约见 tools/README.md“基准输出契约”"
        }
      }
    },
    "polynomial": {
