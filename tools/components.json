            "{repo_root}/Src/grid_search/benchmarks/run_suite.sh",
            "--build-dir",
            "{build_dir}",
            "--output-dir",
            "{run_dir}/outputs",
            "--mode",
            "capacity",
            "--backends",
            "smac_2d_astar,jps3d_astar,jps3d_jps,vss2sn_dijkstra,libmultirobot_astar,justinhj_astar,justinhj_astar_nopool"
          ],
          "description": "容量档（2048²/4096² 单次冷启动、种子 0；峰值 RSS 构成与 conversion_ms 单列；超时单列；扩重复按 benchmark_tiers.md §3.3 自动评估）。"
        }
      }
    },
    "sampling_search": {
      "kind": "cmake",
      "description": "二维 RRT* 多实现适配（planner_sampling_search；OMPL/Ch0p1k3/Klamp't/vss2sn 开关默认 ON，ai-winter GPL-3.0 适配延期保持 OFF）",
      "cmake": {
        "options": {
          "PLANNER_BUILD_SAMPLING_SEARCH": "ON",
          "PLANNER_BUILD_COMMON": "ON",
          "PLANNER_SAMPLING_SEARCH_WITH_OMPL": "ON",
          "PLANNER_SAMPLING_SEARCH_WITH_CH0P1K3": "ON",
          "PLANNER_SAMPLING_SEARCH_WITH_KLAMPT": "ON",
          "PLANNER_SAMPLING_SEARCH_WITH_VSS2SN": "ON"
        },
        "target": "planner_sampling_search"
      },
      "test": {
        "runner": "ctest",
        "label": "sampling_search",
        "workers": 1
      },
      "benchmark_suites": {
        "v1": {
          "command": [
            "{build_dir}/Src/sampling_search/benchmarks/planner_sampling_search_bench",
            "--suite",
            "v1",
            "--output-dir",
            "{run_dir}/outputs"
          ],
          "description": "正式基准（独占窗口）：连续组 4 目标（Informed 单列）× 6 场景 × 预算 0.1/0.5/1/5 s × 种子 0–29；栅格组 vss2sn × 6 类 × 3 规模（seed 0 几何）× 4 预算 × 30 种子；容量档单次（连续放大 2 实例 + 栅格 2048²/4096² 12 实例）；每 trial 独立子进程（OMPL 进程级种子）；指标契约见 tools/README.md §7.2 与 Docs/expansion/benchmark_tiers.md §5"
        }
      }
    }
  },
  "extension_example": {
    "example_component": {
      "kind": "cmake",
      "description": "示例：接入新的 CMake 组件",
      "cmake": {
        "options": {
          "PLANNER_BUILD_EXAMPLE": "ON"
        },
