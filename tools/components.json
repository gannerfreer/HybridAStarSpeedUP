    "web": {
      "kind": "npm",
      "description": "浏览器工作台（TypeScript/React/Canvas；W1–W5）",
      "dir": "Src/web",
      "install": [
        "npm",
        "install",
        "--no-audit",
        "--no-fund"
      ],
      "install_ci": [
        "npm",
        "ci",
        "--no-audit",
        "--no-fund"
      ],
      "build": [
        "npm",
        "run",
        "build"
      ],
      "test": [
        "npm",
        "run",
        "test"
      ],
      "service": {
        "command": [
          "npm",
          "run",
          "serve",
          "--",
          "--run-dir",
          "{run_dir}"
        ],
        "workers": 1,
        "description": "W5 本地服务（HTTP/WebSocket）；脚本名 serve 由前端包实现，改名时同步更新本条目"
      },
      "benchmark_suites": {
        "grid_display": {
          "command": [
            "python3",
            "Src/web/scripts/grid_display_bench.py",
            "--output-dir",
            "{run_dir}/outputs"
          ],
          "description": "显示档性能基准（256²/512²/1024² 栅格显示；X-W1 首次实测，正式基准已复跑：20261012T211851904122Z_web_a7ccc602，15/15 门槛 pass）",
          "output_contract": "指标文件 outputs/grid_display_metrics.csv（显示专有列：传输/解析/纹理/帧/内存等；不写通用 benchmark_metrics.csv，运行目录 metrics.csv 仅 task_summary 行，benchmark_metrics_missing 为预期事件）；另有 outputs/grid_display_bench.json、grid_display_{256,512,1024}.png、grid_display_dpr2_1024.png、cdp_chrome.log"
        }
      },
      "test_junit": "reports/junit.xml"
    },
