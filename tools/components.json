            "{run_dir}/outputs"
          ],
          "description": "正式基准（独占窗口）；指标契约见 tools/README.md“基准输出契约”"
        }
      }
    },
    "corridor": {
      "kind": "cmake",
      "description": "安全走廊生成",
      "cmake": {
        "options": {
          "PLANNER_BUILD_CORRIDOR": "ON"
        },
        "target": "planner_corridor"
      },
      "test": {
        "runner": "ctest",
        "label": "corridor"
      },
      "benchmark_suites": {}
    },
    "hybrid_astar": {
      "kind": "cmake",
      "description": "Hybrid A*（Smac / KTH / zm0612 适配与选型）",
      "cmake": {
        "options": {
          "PLANNER_BUILD_HYBRID_ASTAR": "ON",
          "PLANNER_BUILD_RS": "ON",
          "PLANNER_BUILD_COLLISION": "ON"
        },
        "target": "planner_hybrid_astar"
      },
      "test": {
        "runner": "ctest",
        "label": "hybrid_astar"
      },
      "benchmark_suites": {
        "v1": {
          "command": [
            "taskset",
            "-c",
            "0-7",
            "{build_dir}/Src/hybrid_astar/planner_hybrid_astar_bench",
            "--suite",
            "v1",
            "--output-dir",
            "{run_dir}/outputs"
          ],
          "description": "正式基准（独占窗口，绑定 P 核 0-7 屏蔽大小核迁移）；指标契约见 tools/README.md“基准输出契约”"
        },
        "v2": {
          "command": [
            "taskset",
            "-c",
            "0-7",
            "{build_dir}/Src/hybrid_astar/planner_hybrid_astar_bench",
            "--suite",
            "v2",
            "--fixtures-dir",
            "{repo_root}/tests/fixtures/v7",
            "--output-dir",
            "{run_dir}/outputs"
          ],
          "description": "统一栅格档实验（2026-10-16，独占窗口，绑定 P 核 0-7 屏蔽大小核迁移）：fixtures v7 全量 36 场景（6 类 × 6 变体，统一画布）；4 个 normalized 后端（ros_free/kth_normalized/zm0612_normalized/smac_normalized）叠加统一 xy_resolution_m=0.5 / heading_bins=72 / motion_step_m=1.0 / reverse_motion_step_m=1.0，3 个 native 保持原配置作参考；门槛/选型用途保持默认 5.0 s 预算（实测 2.0 s 会把 300 个成功样本转为 timeout 并破坏门槛评估，故注册命令不降预算；纯速度实验可显式传 --time-budget-s 2.0，结果不用于门槛）；输出契约与 v1 相同，selection.json 标记 experimental=true，选择字段仅供实验参考、不替换 v1 正式选型"
        },
        "v3": {
          "command": [
            "{build_dir}/Src/hybrid_astar/planner_hybrid_astar_bench",
            "--suite",
            "v3",
            "--fixtures-dir",
            "{repo_root}/tests/fixtures/v8",
            "--vehicle",
            "parking_bench.json",
            "--cold-only",
            "--warmup-runs",
            "0",
            "--measured-runs",
            "1",
            "--time-budget-s",
            "30",
            "--jobs",
            "8",
            "--export-paths-dir",
            "{run_dir}/outputs/paths",
            "--output-dir",
            "{run_dir}/outputs"
          ],
          "description": "停车基准探索性套件（fixtures v8）：TITS 2022 论文 115 个停车场景 × 4 个 normalized 后端（ros_free/kth_normalized/zm0612_normalized/smac_normalized），统一栅格 overlay（同 v2）；协议：冷启动单次 + 路径导出，30 s 预算，8 并行 worker；expected 统一 success，失败只记录；选择字段仅供实验参考、不替换 v1 正式选型。对比图工具：tools/parking_compare_plots.py。"
        },
        "v4": {
          "command": [
            "{build_dir}/Src/hybrid_astar/planner_hybrid_astar_bench",
            "--suite",
            "v4",
            "--fixtures-dir",
            "{repo_root}/tests/fixtures/v9",
            "--vehicle",
            "parkbench_vehicle.json",
            "--cold-only",
            "--warmup-runs",
            "0",
            "--measured-runs",
            "1",
            "--time-budget-s",
            "30",
            "--jobs",
            "8",
            "--export-paths-dir",
            "{run_dir}/outputs/paths",
            "--output-dir",
            "{run_dir}/outputs"
          ],
          "description": "ParkBench 探索性套件（fixtures v9）：Constrained_Parking_Scenarios（arXiv:2601.22545，CC-BY-NC-4.0）限制倒车入库 51 场景× 4 个 normalized 后端，统一栅格 overlay（同 v2）；车辆 = ParkBench 论文车（4.95×2.00 m、轴距 3.0 m、满舵 32°）；协议：冷启动单次 + 路径导出，30 s 预算，8 并行 worker；选择字段仅供实验参考、不替换 v1 正式选型。"
        }
      }
    },
    "validation": {
